{
  "daemon": true,
  "run": [
    {
      "method": "shell.run",
      "params": {
        "venv": "env",
        "message": "streamlit run app.py --server.port 8504 --server.headless true"
      }
    },
    {
      "method": "local.set",
      "params": {
        "url": "http://127.0.0.1:8504"
      }
    }
  ]
}
